<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1D"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- TOP LEVEL TABS -->
    <LinearLayout
        android:id="@+id/main_tabs_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="20dp"
        android:paddingHorizontal="40dp"
        android:background="#1A1A1D"
        android:elevation="10dp">

        <Button
            android:id="@+id/btn_main_tab_browser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browser"
            android:background="@drawable/bg_focusable"
            android:textColor="#FFF"
            android:textAllCaps="false"
            android:paddingHorizontal="30dp"
            android:layout_marginEnd="10dp"/>

        <Button
            android:id="@+id/btn_main_tab_streams"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Streams"
            android:background="@drawable/bg_focusable"
            android:textColor="#FFF"
            android:textAllCaps="false"
            android:paddingHorizontal="30dp"
            android:alpha="0.5"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/home_settings_btn"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_focusable"
            android:src="@drawable/ic_settings"
            app:tint="#FFF"
            android:contentDescription="Settings"/>
    </LinearLayout>

    <!-- 1. MODERN HOME SCREEN (BROWSER TAB) -->
    <LinearLayout
        android:id="@+id/home_screen_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="10dp"
        android:layout_marginTop="70dp">

        <!-- Search Bar -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/home_url_input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="60dp"
                android:background="@drawable/bg_focusable"
                android:textColor="#FFFFFF"
                android:padding="16dp"
                android:hint="Search Google or type a URL..."
                android:textColorHint="#888888"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:maxLines="1"/>

            <ImageButton
                android:id="@+id/home_go_btn"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_focusable"
                android:src="@drawable/ic_go"
                app:tint="#FFF"
                android:layout_marginStart="10dp"
                android:contentDescription="Go"/>
        </LinearLayout>

        <!-- Category Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp">

            <Button android:id="@+id/home_tab_tabs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open Tabs" android:drawableStart="@drawable/ic_tab" android:drawablePadding="10dp" android:paddingHorizontal="20dp" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginEnd="10dp" android:textAllCaps="false"/>
            <Button android:id="@+id/home_tab_bookmarks" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bookmarks" android:drawableStart="@drawable/ic_heart_empty" android:drawablePadding="10dp" android:paddingHorizontal="20dp" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginEnd="10dp" android:textAllCaps="false"/>
            <Button android:id="@+id/home_tab_history" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="History" android:drawableStart="@drawable/ic_history" android:drawablePadding="10dp" android:paddingHorizontal="20dp" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginEnd="10dp" android:textAllCaps="false"/>
            <Button android:id="@+id/home_tab_downloads" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Downloads" android:drawableStart="@drawable/ic_download" android:drawablePadding="10dp" android:paddingHorizontal="20dp" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginEnd="10dp" android:textAllCaps="false"/>

        </LinearLayout>

        <!-- Content Panels -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout android:id="@+id/home_panel_tabs" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="visible">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginBottom="10dp">
                    <Button android:id="@+id/btn_restore_tabs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:text="Restore All Tabs" android:visibility="gone"/>
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/open_tabs_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout android:id="@+id/home_panel_bookmarks" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end" android:layout_marginBottom="10dp">
                    <Button android:id="@+id/btn_bookmarks_prev" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:text="&lt; Prev" android:visibility="gone" android:layout_marginEnd="10dp"/>
                    <Button android:id="@+id/btn_bookmarks_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:text="Next &gt;" android:visibility="gone"/>
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/favorites_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout android:id="@+id/home_panel_history" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/history_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="10dp" android:clipToPadding="false"/>
                </HorizontalScrollView>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="10dp">
                    <Button android:id="@+id/btn_clear_history" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:text="Clear History" android:paddingHorizontal="25dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/home_panel_downloads" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/downloads_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="10dp" android:clipToPadding="false"/>
                </HorizontalScrollView>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="10dp">
                    <Button android:id="@+id/btn_view_all_downloads" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:text="Manage Downloads" android:paddingHorizontal="25dp"/>
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

    <!-- STREAMS TAB -->
    <LinearLayout
        android:id="@+id/streams_screen_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="10dp"
        android:layout_marginTop="70dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
            <ImageButton
                android:id="@+id/btn_streams_back"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_focusable"
                android:src="@drawable/ic_back"
                app:tint="#FFF"
                android:visibility="gone"
                android:layout_marginEnd="10dp"
                android:contentDescription="Back"/>
            <Button
                android:id="@+id/btn_streams_stop"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="Stop Scanning"
                android:drawableStart="@drawable/ic_stop"
                android:drawablePadding="10dp"
                android:paddingHorizontal="20dp"
                android:background="@drawable/bg_focusable"
                android:textColor="#FFF"
                android:visibility="gone"
                android:textAllCaps="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/streams_search_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/streams_search_input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="60dp"
                android:background="@drawable/bg_focusable"
                android:textColor="#FFFFFF"
                android:padding="16dp"
                android:hint="Search Movie or TV Show..."
                android:textColorHint="#888888"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1"/>

            <ImageButton
                android:id="@+id/streams_search_btn"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_focusable"
                android:src="@drawable/ic_go"
                app:tint="#FFF"
                android:layout_marginStart="10dp"
                android:contentDescription="Search"/>
        </LinearLayout>

        <!-- History and Recently Played Section -->
        <LinearLayout
            android:id="@+id/streams_history_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <!-- Recent Searches -->
            <LinearLayout
                android:id="@+id/streams_recent_searches_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recent Searches"
                        android:textColor="#888"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btn_streams_clear_history"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Clear"
                        android:background="@drawable/bg_focusable"
                        android:textColor="#FFF"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:paddingHorizontal="15dp"/>
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/streams_history_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Recently Played Videos -->
            <LinearLayout
                android:id="@+id/streams_recent_played_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="30dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recently Played"
                        android:textColor="#888"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btn_streams_clear_recent_played"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Clear"
                        android:background="@drawable/bg_focusable"
                        android:textColor="#FFF"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:paddingHorizontal="15dp"/>
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/streams_recent_played_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/streams_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            android:progressTint="#00BCD4"
            android:progressBackgroundTint="#333"/>

        <TextView
            android:id="@+id/subtitles_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFC107"
            android:textSize="12sp"
            android:visibility="gone"
            android:gravity="center_horizontal"/>

        <ProgressBar
            android:id="@+id/subtitles_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            android:progressTint="#FFC107"
            android:progressBackgroundTint="#333"/>

        <ScrollView
            android:id="@+id/streams_results_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/streams_results_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>

    <FrameLayout android:id="@+id/web_container" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />

    <LinearLayout
        android:id="@+id/top_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F2111111"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:background="#222">
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/tabs_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
            <ImageButton android:id="@+id/btn_new_tab" android:layout_width="50dp" android:layout_height="50dp" android:background="@drawable/bg_focusable" android:src="@drawable/ic_add" app:tint="#FFF" android:layout_marginStart="10dp" android:contentDescription="New Tab"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp">
            <ImageButton android:id="@+id/top_home_btn" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_focusable" android:src="@drawable/ic_home" app:tint="#FFF" android:contentDescription="Home" />
            <ImageButton android:id="@+id/top_back_btn" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_focusable" android:src="@drawable/ic_back" app:tint="#FFF" android:layout_marginStart="10dp" android:contentDescription="Back" />
            <ImageButton android:id="@+id/top_forward_btn" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_focusable" android:src="@drawable/ic_forward" app:tint="#FFF" android:layout_marginStart="10dp" android:contentDescription="Forward" />
            <EditText android:id="@+id/top_url_input" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:layout_marginHorizontal="10dp" android:background="@drawable/bg_focusable" android:textColor="#FFFFFF" android:paddingHorizontal="10dp" android:inputType="textUri" android:imeOptions="actionGo" android:maxLines="1"/>
            <ImageButton android:id="@+id/top_go_btn" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_focusable" android:src="@drawable/ic_go" app:tint="#FFF" android:layout_marginEnd="5dp" android:contentDescription="Go"/>
            <ImageButton android:id="@+id/top_refresh_btn" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_focusable" android:src="@drawable/ic_refresh" app:tint="#FFF" android:layout_marginEnd="5dp" android:contentDescription="Refresh"/>
            <ImageButton android:id="@+id/top_auto_play_btn" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_focusable" android:src="@drawable/ic_auto_play" app:tint="#888" android:layout_marginEnd="5dp" android:contentDescription="Auto-play Video Mode"/>
            <ImageButton android:id="@+id/top_record_btn" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_focusable" android:src="@drawable/ic_record" app:tint="#FFF" android:layout_marginEnd="5dp" android:visibility="gone" android:contentDescription="Record Autoplay Sequence"/>
            <ImageButton android:id="@+id/top_fav_btn" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_focusable" android:src="@drawable/ic_heart_empty" app:tint="#FFF" android:layout_marginEnd="5dp" android:contentDescription="Favorite"/>
            <ImageButton android:id="@+id/top_downloads_btn" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_focusable" android:src="@drawable/ic_download" app:tint="#FFF" android:layout_marginEnd="10dp" android:contentDescription="Downloads" />
            <ImageButton android:id="@+id/top_settings_btn" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_focusable" android:src="@drawable/ic_settings" app:tint="#FFF" android:contentDescription="Settings" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fullscreen_custom_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/native_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone"/>

    </FrameLayout>

    <ImageView android:id="@+id/cursor" android:layout_width="32dp" android:layout_height="32dp" android:tint="@null" app:tint="@null" android:src="@drawable/ic_cursor" android:elevation="20dp" android:translationZ="20dp" android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/context_menu"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:background="#E6222222"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        android:elevation="25dp">
        <Button android:id="@+id/ctx_new_tab" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open in New Tab" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:paddingHorizontal="15dp" android:gravity="start|center_vertical" android:textAllCaps="false"/>
        <Button android:id="@+id/ctx_refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Refresh" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:paddingHorizontal="15dp" android:gravity="start|center_vertical" android:textAllCaps="false"/>
        <Button android:id="@+id/ctx_block" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Block Element" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:paddingHorizontal="15dp" android:gravity="start|center_vertical" android:textAllCaps="false"/>
    </LinearLayout>

</FrameLayout>
