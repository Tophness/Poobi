<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1D"
    android:orientation="horizontal">

    <!-- SIDEBAR -->
    <LinearLayout
        android:id="@+id/settings_sidebar"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:background="#222225"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#00BCD4"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button android:id="@+id/cat_general" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="General" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginBottom="10dp" android:gravity="start|center_vertical" android:paddingStart="20dp" android:textAllCaps="false" android:nextFocusRight="@+id/theme_btn"/>
                <Button android:id="@+id/cat_web" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Web" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginBottom="10dp" android:gravity="start|center_vertical" android:paddingStart="20dp" android:textAllCaps="false" android:nextFocusRight="@+id/popup_pref_btn"/>
                <Button android:id="@+id/cat_player" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Player" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginBottom="10dp" android:gravity="start|center_vertical" android:paddingStart="20dp" android:textAllCaps="false" android:nextFocusRight="@+id/video_pref_btn"/>
                <Button android:id="@+id/cat_interface" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Interface" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginBottom="10dp" android:gravity="start|center_vertical" android:paddingStart="20dp" android:textAllCaps="false" android:nextFocusRight="@+id/scroll_topbar_btn"/>
                <Button android:id="@+id/cat_streaming" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Streaming" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginBottom="10dp" android:gravity="start|center_vertical" android:paddingStart="20dp" android:textAllCaps="false"/>
                <Button android:id="@+id/cat_autoplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Autoplay" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginBottom="10dp" android:gravity="start|center_vertical" android:paddingStart="20dp" android:textAllCaps="false" android:nextFocusRight="@+id/video_trigger_btn"/>
                <Button android:id="@+id/cat_subtitles" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Subtitles" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginBottom="10dp" android:gravity="start|center_vertical" android:paddingStart="20dp" android:textAllCaps="false"/>
                <Button android:id="@+id/cat_sorting" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Source Sorting" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginBottom="10dp" android:gravity="start|center_vertical" android:paddingStart="20dp" android:textAllCaps="false"/>
                <Button android:id="@+id/cat_blocked" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Blocked Elements" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginBottom="10dp" android:gravity="start|center_vertical" android:paddingStart="20dp" android:textAllCaps="false"/>
                <Button android:id="@+id/cat_trakt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trakt.tv" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginBottom="10dp" android:gravity="start|center_vertical" android:paddingStart="20dp" android:textAllCaps="false"/>
                <Button android:id="@+id/cat_sync" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sync &amp; Backup" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginBottom="10dp" android:gravity="start|center_vertical" android:paddingStart="20dp" android:textAllCaps="false"/>

            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save &amp; Exit"
            android:background="@drawable/bg_green_focusable"
            android:textColor="#FFFFFF"
            android:padding="16dp"
            android:layout_marginTop="10dp"/>
    </LinearLayout>

    <!-- CONTENT AREA -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="40dp">

            <!-- GENERAL CATEGORY -->
            <LinearLayout android:id="@+id/panel_general" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="General Settings" android:textColor="#FFF" android:textSize="22sp" android:layout_marginBottom="20dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Appearance" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/theme_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Theme: Dark" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_general"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Session &amp; Storage" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/restore_pref_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Restore Tabs: Ask" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_general"/>
                <Button android:id="@+id/history_limit_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="History Limit: 20" android:gravity="start" android:nextFocusLeft="@+id/cat_general"/>
            </LinearLayout>

            <!-- WEB CATEGORY -->
            <LinearLayout android:id="@+id/panel_web" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Web &amp; Content" android:textColor="#FFF" android:textSize="22sp" android:layout_marginBottom="20dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Popups &amp; Ads" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/popup_pref_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Popups: Block Silently" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_web"/>
                <Button android:id="@+id/clickjack_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Clickjack Prevention: Enabled" android:layout_marginBottom="20dp" android:gravity="start" android:nextFocusLeft="@+id/cat_web"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AdBlock List URL (EasyList format):" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/adblock_url_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="16dp" android:inputType="textUri" android:maxLines="1" android:nextFocusLeft="@+id/cat_web"/>
            </LinearLayout>

            <!-- PLAYER CATEGORY -->
            <LinearLayout android:id="@+id/panel_player" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Video Player" android:textColor="#FFF" android:textSize="22sp" android:layout_marginBottom="20dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Extraction" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/video_pref_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Native Player Hijack: Ask" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_player"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ExoPlayer Errors" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/exo_fallback_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="On Error: Ask to open in Browser" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_player"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Subtitles" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/embedded_subs_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Embedded Subtitles: Enabled" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_player"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Binge Watching / Auto-play" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/up_next_pref_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Up Next Popup: Ask" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_player"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Show Popup (seconds before end)" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                    <EditText android:id="@+id/up_next_time_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="16dp" android:inputType="number" android:text="20" android:nextFocusLeft="@+id/cat_player"/>
                </LinearLayout>

                <Button android:id="@+id/autoplay_next_mode_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Source Selection: Closest Source" android:gravity="start" android:nextFocusLeft="@+id/cat_player"/>
            </LinearLayout>

            <!-- STREAMING CATEGORY -->
            <LinearLayout android:id="@+id/panel_streaming" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Streaming Settings" android:textColor="#FFF" android:textSize="22sp" android:layout_marginBottom="20dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Timeout Engine" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/timeout_mode_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Timeout Mode: Both" android:layout_marginBottom="10dp" android:gravity="start" android:nextFocusLeft="@+id/cat_streaming"/>

                <LinearLayout android:id="@+id/global_timeout_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Global Timeout (seconds)" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                    <EditText android:id="@+id/global_timeout_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="16dp" android:inputType="number" android:text="30" android:layout_marginBottom="10dp" android:nextFocusLeft="@+id/cat_streaming"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/source_timeout_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Per-Source Timeout (seconds)" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                    <EditText android:id="@+id/source_timeout_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="16dp" android:inputType="number" android:text="15" android:layout_marginBottom="16dp" android:nextFocusLeft="@+id/cat_streaming"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Provider Packages" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                <LinearLayout android:id="@+id/provider_packs_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Host Whitelists" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/whitelist_toggle_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Use Only Whitelisted Hosts: Disabled" android:layout_marginBottom="10dp" android:gravity="start" android:nextFocusLeft="@+id/cat_streaming"/>

                <LinearLayout android:id="@+id/whitelist_controls_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
                        <Button android:id="@+id/btn_whitelist_select_all" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Select All" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:layout_marginEnd="5dp" android:textAllCaps="false"/>
                        <Button android:id="@+id/btn_whitelist_clear_all" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Clear All" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:textAllCaps="false"/>
                    </LinearLayout>
                    <EditText android:id="@+id/host_search_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="16dp" android:hint="Search all whitelists..." android:textColorHint="#666" android:layout_marginBottom="10dp" android:nextFocusLeft="@+id/cat_streaming"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <!-- Provider Sources Whitelist (Left) -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Provider Sources Whitelist" android:textColor="#00BCD4" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="5dp"/>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/provider_hosts_recycler"
                                android:layout_width="match_parent"
                                android:layout_height="500dp"
                                android:scrollbars="vertical"
                                android:focusable="false"
                                android:descendantFocusability="afterDescendants"/>
                        </LinearLayout>

                        <!-- ResolveURL Whitelist (Right) -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ResolveURL Host Whitelist" android:textColor="#00BCD4" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="5dp"/>
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/resolveurl_hosts_recycler"
                                android:layout_width="match_parent"
                                android:layout_height="500dp"
                                android:scrollbars="vertical"
                                android:focusable="false"
                                android:descendantFocusability="afterDescendants"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- INTERFACE CATEGORY -->
            <LinearLayout android:id="@+id/panel_interface" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Interface &amp; Navigation" android:textColor="#FFF" android:textSize="22sp" android:layout_marginBottom="20dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Navigation Bar" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/scroll_topbar_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Scroll Up for Top Bar: Enabled" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_interface"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Navigation Mode" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/navigation_mode_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Navigation Mode: Cursor" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_interface"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Icons Style" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/history_icon_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="History Icons: Thumbnail" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_interface"/>
                <Button android:id="@+id/bookmark_icon_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Bookmark Icons: Thumbnail" android:gravity="start" android:nextFocusLeft="@+id/cat_interface"/>
            </LinearLayout>

            <!-- AUTOPLAY CATEGORY -->
            <LinearLayout android:id="@+id/panel_autoplay" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Autoplay Profiles" android:textColor="#FFF" android:textSize="22sp" android:layout_marginBottom="20dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Global Control" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/video_trigger_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Auto-play Video: Disabled" android:layout_marginBottom="20dp" android:gravity="start" android:nextFocusLeft="@+id/cat_autoplay"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Custom Profiles" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                <LinearLayout android:id="@+id/autoplay_profiles_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>

            <!-- BLOCKED ELEMENTS CATEGORY -->
            <LinearLayout android:id="@+id/panel_blocked" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Blocked Page Elements" android:textColor="#FFF" android:textSize="22sp" android:layout_marginBottom="20dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Custom Rules" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                <LinearLayout android:id="@+id/blocked_elements_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>

            <!-- SUBTITLES CATEGORY -->
            <LinearLayout android:id="@+id/panel_subtitles" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Subtitle Settings" android:textColor="#FFF" android:textSize="22sp" android:layout_marginBottom="20dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Playback Behavior" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <Button android:id="@+id/auto_sub_pref_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Auto-search Subtitles: Ask" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_subtitles"/>

                <LinearLayout android:id="@+id/auto_sub_count_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Automatic Subtitle Count" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                    <Button android:id="@+id/auto_sub_count_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Add: 1 Subtitle" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_subtitles"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wait for Subtitles" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                    <Button android:id="@+id/auto_sub_wait_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Wait: Automatic (Ask)" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_subtitles"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/sub_retention_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keep downloaded subs for (days)" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                    <Button android:id="@+id/sub_retention_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Retention: 3 Days" android:layout_marginBottom="16dp" android:gravity="start" android:nextFocusLeft="@+id/cat_subtitles"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Search Preferences" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="5dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Languages (comma separated):" android:textColor="#888" android:textSize="12sp"/>
                <EditText android:id="@+id/sub_langs_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="12dp" android:text="English" android:layout_marginBottom="10dp" android:nextFocusLeft="@+id/cat_subtitles"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Result Limit:" android:textColor="#888" android:textSize="12sp"/>
                <EditText android:id="@+id/sub_limit_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="12dp" android:inputType="number" android:text="20" android:layout_marginBottom="16dp" android:nextFocusLeft="@+id/cat_subtitles"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Subtitle Services" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                <LinearLayout android:id="@+id/sub_services_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Account Settings / API Keys" android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/opensub_user_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="12dp" android:hint="OpenSubtitles Username" android:layout_marginBottom="8dp" android:nextFocusLeft="@+id/cat_subtitles"/>
                <EditText android:id="@+id/opensub_pass_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="12dp" android:hint="OpenSubtitles Password" android:inputType="textPassword" android:layout_marginBottom="8dp" android:nextFocusLeft="@+id/cat_subtitles"/>
                <EditText android:id="@+id/opensub_org_user_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="12dp" android:hint="OpenSubtitles.org Username" android:layout_marginBottom="8dp" android:nextFocusLeft="@+id/cat_subtitles"/>
                <EditText android:id="@+id/opensub_org_pass_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="12dp" android:hint="OpenSubtitles.org Password" android:inputType="textPassword" android:layout_marginBottom="8dp" android:nextFocusLeft="@+id/cat_subtitles"/>
                <EditText android:id="@+id/subdl_key_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="12dp" android:hint="SubDL API Key" android:layout_marginBottom="8dp" android:nextFocusLeft="@+id/cat_subtitles"/>
                <EditText android:id="@+id/subsource_key_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#333" android:textColor="#FFF" android:padding="12dp" android:hint="Subsource API Key" android:layout_marginBottom="16dp" android:nextFocusLeft="@+id/cat_subtitles"/>
            </LinearLayout>

            <!-- SORTING CATEGORY -->
            <LinearLayout android:id="@+id/panel_sorting" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Source Sorting Priorities" android:textColor="#FFF" android:textSize="22sp" android:layout_marginBottom="20dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Drag or use arrows to set the priority order for source results. The top item is the primary sort criteria." android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="16dp"/>

                <LinearLayout android:id="@+id/sorting_priorities_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>

            <!-- TRAKT CATEGORY -->
            <LinearLayout android:id="@+id/panel_trakt" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trakt.tv Integration" android:textColor="#FFF" android:textSize="22sp" android:layout_marginBottom="20dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sync your watched progress and collection with Trakt.tv." android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="20dp"/>

                <TextView android:id="@+id/trakt_status_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Not authorized." android:textColor="#AAA" android:textSize="16sp" android:layout_marginBottom="20dp"/>

                <Button android:id="@+id/trakt_auth_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Authorize Trakt" android:layout_marginBottom="16dp" android:gravity="start" android:textAllCaps="false" android:nextFocusLeft="@+id/cat_trakt"/>

                <Button android:id="@+id/trakt_sync_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Sync Library" android:layout_marginBottom="16dp" android:gravity="start" android:textAllCaps="false" android:visibility="gone" android:nextFocusLeft="@+id/cat_trakt"/>
            </LinearLayout>

            <!-- SYNC CATEGORY -->
            <LinearLayout android:id="@+id/panel_sync" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Google Drive Sync" android:textColor="#FFF" android:textSize="22sp" android:layout_marginBottom="20dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sync your settings, bookmarks, and history across devices using your own Google Drive storage (App Data folder). This is private and only accessible by this app." android:textColor="#888" android:textSize="14sp" android:layout_marginBottom="20dp"/>

                <TextView android:id="@+id/sync_status_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Not signed in." android:textColor="#AAA" android:textSize="16sp" android:layout_marginBottom="20dp"/>

                <Button android:id="@+id/google_login_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Sign in with Google" android:layout_marginBottom="16dp" android:gravity="start" android:textAllCaps="false" android:nextFocusLeft="@+id/cat_sync"/>

                <ProgressBar android:id="@+id/sync_progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" android:layout_marginBottom="16dp"/>

                <Button android:id="@+id/manual_sync_btn" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_focusable" android:textColor="#FFF" android:padding="16dp" android:text="Force Sync Now" android:layout_marginBottom="16dp" android:gravity="start" android:textAllCaps="false" android:visibility="gone" android:nextFocusLeft="@+id/cat_sync"/>
            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>
