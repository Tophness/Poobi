<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_focusable"
    android:padding="10dp"
    android:layout_marginBottom="5dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/episode_thumb"
        android:layout_width="160dp"
        android:layout_height="90dp"
        android:scaleType="centerCrop"
        android:background="#222"
        android:layout_marginEnd="15dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/episode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="E1: Episode Title" />

        <TextView
            android:id="@+id/episode_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginTop="4dp"
            android:text="Episode overview text goes here..." />
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_watched"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_watched"
        android:padding="10dp"
        app:tint="#FFF"
        android:alpha="0.2"
        android:duplicateParentState="true"
        android:contentDescription="Watched Status"/>
</LinearLayout>
