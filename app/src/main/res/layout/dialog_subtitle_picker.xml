<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#111111">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Subtitles"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:background="@drawable/bg_focusable"
            android:textColor="#FFFFFF"
            android:nextFocusDown="@+id/sub_list" />
        <Button
            android:id="@+id/btn_download"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Download Selected"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_green_focusable"
            android:textColor="#FFFFFF"
            android:nextFocusDown="@+id/sub_list" />
    </LinearLayout>

    <ListView
        android:id="@+id/sub_list"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="16dp"
        android:choiceMode="multipleChoice"
        android:divider="#333333"
        android:dividerHeight="1dp"
        android:nextFocusUp="@+id/btn_download" />
</LinearLayout>